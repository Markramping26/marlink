<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to uploaded files (avatars, chat media, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all other API requests through server.php
    RewriteRule ^(.*)$ server.php [QSA,L]
</IfModule>
